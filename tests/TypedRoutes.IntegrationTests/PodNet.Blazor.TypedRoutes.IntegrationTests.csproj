<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<NugetizerIntegrationTest>true</NugetizerIntegrationTest>
		<RestoreAdditionalProjectSources>$(ArtifactsPath)/package/$(Configuration.ToLowerInvariant())</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="MSTest" Version="3.5.2" />

		<PackageReference Include="PodNet.Blazor.TypedRoutes" Version="[$(PackageUnderTestVersion)]" />
	</ItemGroup>

</Project>
